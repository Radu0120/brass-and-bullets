	quest.7AE7F2DA6149F569.title: "Tesla Coil"
	quest.7AF266675913A0B1.title: "Netherite Chest"
	quest.7C5E21A17A030622.quest_desc: ["Do not make noise. Do not bring a torch. Bring a lot of food."]
	quest.7C5E21A17A030622.title: "Ancient City"
	quest.7CAAB885AB665BE1.quest_desc: ["Shoots almost any food or small item. Surprisingly lethal."]
	quest.7CAAB885AB665BE1.title: "Potato Cannon"
	quest.7CAF04E48DBF509F.title: "Dissident"
	quest.7D99700A6A86D170.quest_desc: [
