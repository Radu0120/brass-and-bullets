	quest.5E59B6F2970B3487.title: "Combat Shotgun"
	quest.5ECBBE80564AEAA6.quest_desc: ["Right-click an animal with the dictionary to learn what it eats and where to find it. Look in JEI for the recipe."]
	quest.5ECBBE80564AEAA6.title: "Animal Dictionary"
	quest.5F1D908D2DEDCA24.title: "Steam Whistle"
	quest.5F91D2BEA8B41967.quest_desc: ["Powered armour with room for modules. Look at the Exo Suit Core in JEI."]
