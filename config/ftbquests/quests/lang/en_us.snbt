	chapter.46B862BD16703034.title: "&6Getting Started"
	chapter.5A16EBBB03054B49.chapter_subtitle: [
		"Tame, breed and look after every animal"
		"Farm animals, pets, and the odd frog"
	]
	chapter.5A16EBBB03054B49.title: "&dPets \\& Livestock"
	chapter.5FB7D2E1791C3EB2.chapter_subtitle: [
		"Vanilla, Mowzie's Mobs and L_Ender's Cataclysm"
		"Bring friends, armour, and a plan"
	]
	chapter.5FB7D2E1791C3EB2.title: "&4Bosses \\& Beasts"
