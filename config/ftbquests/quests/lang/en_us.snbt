	]
	chapter.33FC7BB1A9A7A575.title: "&4Bosses \\& Beasts"
	chapter.35B12A34E27EA91F.chapter_subtitle: [
		"Take to the sky"
		"Contraptions that really move"
	]
	chapter.35B12A34E27EA91F.title: "&bAeronautics \\& Sable"
	chapter.3B56970D6AC06022.chapter_subtitle: ["Powder, brass and a lot of gunsmithing"]
	chapter.3B56970D6AC06022.title: "&cScorched Guns"
