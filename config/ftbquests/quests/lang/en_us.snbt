	quest.023430ADEBFD4849.quest_desc: ["Put a fan behind lava, fire, water or smoke and items passing through get smelted, washed, haunted or smoked."]
	quest.023430ADEBFD4849.title: "Encased Fan"
	quest.0406215E1D11FD49.quest_desc: ["Right-click an animal with the dictionary to learn what it eats and where to find it. Look in JEI for the recipe."]
	quest.0406215E1D11FD49.title: "Animal Dictionary"
	quest.04329C2564348549.title: "Shipwreck"
	quest.0488D8838BCDDA07.quest_desc: ["Take fire resistance, a stack of blocks and a way home."]
	quest.0488D8838BCDDA07.title: "Into the Fire"
	quest.04D8D40D853B4816.quest_desc: ["Harvesters cut crops as a contraption passes over them. Ploughs till and break plants."]
	quest.04D8D40D853B4816.title: "Harvest Cart"
	quest.052F5B39A8F1F2EE.title: "Train Observer"
	quest.05AD42E5FC49D0B9.title: "Mounted Potato Cannon"
	quest.06B16AA0C8100739.title: "Piglin Donjon"
	quest.072F3146939D16BA.quest_desc: ["A block that wants to float. Look at its recipe in JEI."]
	quest.072F3146939D16BA.title: "Levitite"
	quest.07438B1CE86C0F82.quest_desc: ["Pulls loose items to you as you mine."]
	quest.07438B1CE86C0F82.title: "Magnet"
	quest.0765CAB676CF92ED.title: "Crocodile"
	quest.077FBB5CEA5F59BA.quest_desc: ["Stone tools first, shelter second. The overworld here has more mobs and more dungeons than vanilla, so do not wander far unarmed."]
	quest.077FBB5CEA5F59BA.title: "Survive the Night"
	quest.08E0EA14B6ED2729.title: "Netherite Chest"
	quest.0945D0283C3D6995.quest_desc: ["Feed a wild coati honey from a bottle three Minecraft days in a row. It then walks to its burrow and digs up a baby, which you tame with melon slices."]
	quest.0945D0283C3D6995.title: "Coati"
	quest.094CE6EDDC0007C7.quest_desc: ["Large dishes are placed on the ground and shared. Perfect for a base."]
	quest.094CE6EDDC0007C7.title: "Feast"
	quest.09A3E2CAF195A876.quest_desc: ["Hidden in the overworld. The Harbinger sleeps inside."]
	quest.09A3E2CAF195A876.title: "Ancient Factory"
	quest.0B290EF8606D6CFC.quest_desc: ["Dungeons and Taverns adds many extra structures. Taverns are friendly."]
	quest.0B290EF8606D6CFC.title: "Roadside Tavern"
	quest.0B59A98F72E126A9.quest_desc: ["A Nether ruin guarded by a very large netherite machine."]
	quest.0B59A98F72E126A9.title: "Soul Black Smith"
	quest.0C95E7D77FCCAD80.quest_desc: ["Tomatoes, onions, cabbage and rice. The advancement asks for them all."]
	quest.0C95E7D77FCCAD80.title: "Kitchen Garden"
	quest.0D18C49E00F96704.quest_desc: ["Dig down below level 0 and mine carefully. Lava loves diamond miners."]
	quest.0D18C49E00F96704.title: "Diamonds!"
	quest.0D1CE57D6C9263F4.title: "Portable Engine"
	quest.0D63C113BA5A01C8.quest_desc: ["Seahorses breed on sea pickles, and one parent later hatches several babies."]
	quest.0D63C113BA5A01C8.title: "Seahorse"
	quest.0D709C5A30F87CEF.quest_desc: ["Turn a minecart into a moving contraption. Pair with a train track or a powered rail."]
	quest.0D709C5A30F87CEF.title: "Cart Assembler"
	quest.0D72C10673587139.quest_desc: [
		"&6Brass \\& Bullets&r is a Create-flavoured adventure: gears, airships, guns, farms and a few very angry bosses."
		""
		"This book is a suggestion, not a gate. Every quest is open from the start; the arrows only show a natural order."
		"Quests give a little XP so there is always a reason to tick one off."
	]
	quest.0D72C10673587139.title: "Welcome"
	quest.0DF54B9A953F5A12.quest_desc: ["A fuel made from plant waste. It burns much longer than coal."]
	quest.0DF54B9A953F5A12.title: "Biomass"
	quest.0E4B0F6A67E28B79.quest_desc: ["Charge electric gear from a moving contraption."]
	quest.0E4B0F6A67E28B79.title: "Portable Energy"
	quest.0ED6980FD27E5819.quest_desc: ["Tame a mossbloom with a spore blossom. You can ride it, and it keeps farmland from being trampled and nudges crops to grow."]
	quest.0ED6980FD27E5819.title: "Mossbloom"
	quest.0F16F7A61362E895.quest_desc: ["A knife is the key tool: it cuts food, and collects straw and some drops. Needs only flint and a stick."]
	quest.0F16F7A61362E895.title: "A Sharp Start"
	quest.0FB9D4F9EB60DB1C.quest_desc: [
		"A &6Sophisticated Backpack&r is more than extra slots: upgrade slots add magnets, auto-feeding, restocking and more."
		"Pair it with Sophisticated Storage chests and barrels for a tidy base."
	]
	quest.0FB9D4F9EB60DB1C.title: "Carry More"
	quest.0FD455D4FA9B4745.quest_desc: ["Fills items from above: bottles, buckets, chocolate-covered anything."]
	quest.0FD455D4FA9B4745.title: "Spout"
	quest.101FC3A91E3C0414.title: "Zombie Dungeon"
	quest.10F972DBBF86CCEA.quest_desc: ["Shoots almost any food or small item. Surprisingly lethal."]
	quest.10F972DBBF86CCEA.title: "Potato Cannon"
	quest.10FF7A29BCA74B87.quest_desc: ["Open &eOptions > Controls&r and use the search box. This pack adds a handful of keys for the minimap, skills book, backpacks and more."]
	quest.10FF7A29BCA74B87.title: "Check Your Controls"
	quest.110A0CBB170715F6.title: "Bastion"
	quest.11300B88B69AA585.quest_desc: ["Pumps move fluids through pipes in one direction. Right-click a pipe window with the Wrench to open or close it."]
	quest.11300B88B69AA585.title: "Pipes \\& Pumps"
	quest.115995AAF4388322.quest_desc: ["Breed koi with kelp. Patterns come from the parents, with a small chance of a rare one. Catch them in a bucket."]
	quest.115995AAF4388322.title: "Koi"
	quest.123A4C02C9A482C0.title: "Crafting Upgrade"
	quest.129F1D036432EC2A.quest_desc: ["Echofins swim the End in a chorus and a levitating variety. They sometimes go for the player and can be bucketed."]
	quest.129F1D036432EC2A.title: "Echofin"
	quest.12BD84E6E3D1494F.title: "Patch Up"
	quest.13277AE6F17604A0.quest_desc: ["Smelt iron ore in a furnace. Create will give you faster ways soon, but the furnace is how everyone starts."]
	quest.13277AE6F17604A0.title: "Acquire Hardware"
	quest.13B9CFE30AC38C39.quest_desc: ["A machine of war from the Ancient Factory."]
	quest.13B9CFE30AC38C39.title: "The Harbinger"
	quest.13C0F3C30F964ACF.quest_desc: ["A strong ore found deep underground."]
	quest.13C0F3C30F964ACF.title: "Anthralite"
	quest.13FD338E92A88B77.title: "Hummingbird Feeder"
	quest.1460CA84050461ED.quest_desc: ["A motor with an exact speed you can set by redstone signal."]
	quest.1460CA84050461ED.title: "Servo Motor"
	quest.1477862CB8B575AB.quest_desc: ["A tank of air for your back. Stand on a spinning shaft to refill it."]
	quest.1477862CB8B575AB.title: "Copper Backtank"
	quest.14C5A010F1A0E949.title: "Ending Catalyst"
	quest.14E7149298B98838.title: "Restock"
	quest.156904880A6B3B03.title: "Gantry"
	quest.15706F396A793C9C.quest_desc: ["Copycat blocks look like any block you apply to them. Great for hiding wires and gearing."]
	quest.15706F396A793C9C.title: "Copycats"
	quest.1587DDB331DD0F7C.quest_desc: ["A shattered fortress in the End."]
	quest.1587DDB331DD0F7C.title: "Ruined Citadel"
	quest.15F8144B05263D4D.title: "Asgharian Citadel"
	quest.169C64228C322927.quest_desc: ["Keep two trains from meeting nose to nose."]
	quest.169C64228C322927.title: "Signals"
	quest.16C1B9721E8BE993.quest_desc: ["Tame every cat variant. Stray cats near villages and swamp huts are good places to start."]
	quest.16C1B9721E8BE993.title: "Cat Person"
	quest.17128DE4517B2B44.quest_desc: ["&bJade&r shows what you are pointing at: block names, which tool is needed, crop growth, machine contents and the mod it came from."]
	quest.17128DE4517B2B44.title: "What Am I Looking At?"
	quest.174625E6E4AE16C4.quest_desc: [
