	]
	chapter.265CE3E7CE4F5FFA.title: "&6Wildlife"
	chapter.2B2229074986B056.chapter_subtitle: ["Powder, brass and a lot of gunsmithing"]
	chapter.2B2229074986B056.title: "&cScorched Guns"
	chapter.35B12A34E27EA91F.chapter_subtitle: [
		"Take to the sky"
		"Contraptions that really move"
	]
	chapter.35B12A34E27EA91F.title: "&bAeronautics \\& Sable"
	chapter.3B5DFB54C802C233.chapter_subtitle: [
