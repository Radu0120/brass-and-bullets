	quest.1F1988D430C1F9AB.title: "Netherite Knife"
	quest.1F6EDC700AE5FD9F.quest_desc: ["Haul things up, or drag your ship in to dock."]
	quest.1F6EDC700AE5FD9F.title: "Rope Winch"
	quest.200EBB315D6E07B1.title: "Jetpack Module"
	quest.204861D8AD0496C1.quest_desc: ["A lead keeps animals close, a name tag keeps them yours. Name tags are found in loot, not crafted."]
	quest.204861D8AD0496C1.title: "Lead and Name Tag"
	quest.211E79D361E5CA38.quest_desc: ["Walk on the sea floor. Netherite diving gear works in lava too."]
	quest.211E79D361E5CA38.title: "Diving Gear"
	quest.21A8555A58792546.title: "Capuchin Monkey"
	quest.22167D60ED4D94BD.title: "Ruined Portal"
	quest.222EA17DFEBC5A5A.quest_desc: ["Found in the Nether. Neutral, hunts hoglins and curls up when hurt badly enough. Breeds on fire charges."]
	quest.222EA17DFEBC5A5A.title: "Ember Tortoise"
	quest.224BBEDD54E0D10F.quest_desc: ["Wireless redstone. Put a pair on opposite ends of your base and set matching frequencies."]
	quest.224BBEDD54E0D10F.title: "Redstone Link"
	quest.22E5B8C073AE2098.title: "Netherite Monstrosity"
	quest.236B952B9CE74553.quest_desc: ["Automated mining and woodcutting. Aim the drill at stone and let it run."]
	quest.236B952B9CE74553.title: "Drill \\& Saw"
	quest.23D7FFD5012513B5.quest_desc: ["Glue holds a build together when you assemble it."]
	quest.23D7FFD5012513B5.title: "Honey Glue"
	quest.244E852D0D987685.title: "Cursed Pyramid"
	quest.246F23DC3085BBFE.quest_desc: ["Sleep through the night to set your spawn point. Do it before you wander far from home."]
	quest.246F23DC3085BBFE.title: "Sweet Dreams"
	quest.24A1AFE82B76CE66.title: "Beef Stew"
	quest.24D1939D0DF70023.title: "Pearlescent Levitite"
	quest.25E7DC9CCD0C52A2.quest_desc: ["Wear the glove, tame a bald eagle and send it to fetch things."]
	quest.25E7DC9CCD0C52A2.title: "Falconry Glove"
	quest.2616DAB1FC88E2D7.quest_desc: ["Kinetic power travels through shafts and cogs. Rotate them with the Wrench and watch the direction of spin."]
	quest.2616DAB1FC88E2D7.title: "Shafts \\& Cogwheels"
	quest.272793C34A2906CB.quest_desc: ["Attach sails to a Windmill Bearing and build up. Higher up is better, and it needs no water."]
	quest.272793C34A2906CB.title: "Windmill"
	quest.27E37E3A13AD75F8.quest_desc: ["A hostile mutated piglin. They hit hard in a pack."]
	quest.27E37E3A13AD75F8.title: "Hornlins"
	quest.27F44AD467961D51.quest_desc: ["Doubles how much each slot holds. Stack Upgrades stack on top of each other."]
	quest.27F44AD467961D51.title: "Stack Upgrade"
	quest.28671D309D5E8C60.quest_desc: ["These clockwork guards defend the Cog Chambers. Bring something stronger than a musket."]
	quest.28671D309D5E8C60.title: "Cog Knight"
	quest.293B0FD7A9EBEB5B.quest_desc: ["Found in jungles, and a favourite of several animals."]
	quest.293B0FD7A9EBEB5B.title: "Banana"
	quest.29DF06E204203F75.title: "Rotten Tomato"
	quest.2A2D8179AF22F2DA.title: "Steel Armour"
	quest.2A633DA260ED3B77.quest_desc: ["Sends and receives packages across the base. A frogport on every machine row is a perfect warehouse."]
	quest.2A633DA260ED3B77.title: "Frogport"
	quest.2B1F993CBD221FBC.quest_desc: ["Upgrade an existing chest in place. No need to move anything."]
	quest.2B1F993CBD221FBC.title: "Tier Up"
	quest.2B4F46BCC0C58493.quest_desc: ["Cut tall grass with a knife to harvest straw."]
	quest.2B4F46BCC0C58493.title: "Hay Day"
	quest.2B7FA0364450CB22.title: "The End"
	quest.2BAA79F00DD37986.title: "Rocky Roller"
	quest.2BDFE33F1E14FA81.title: "Black Powder"
	quest.2C7457A9A0C877A6.quest_desc: ["Copper and zinc, mixed with heat. Brass is the mid-game material: most of this pack's gear wants it."]
	quest.2C7457A9A0C877A6.title: "Brass"
	quest.2CC99C3E99D1FBCC.title: "Feeding"
	quest.2D537AB6892BDA66.quest_desc: ["Glued blocks move together on pistons and bearings. Build first, glue second."]
	quest.2D537AB6892BDA66.title: "Super Glue"
	quest.2DC6364FB22850F5.quest_desc: ["A boss from the End. Summon it with a mysterious worm; the advancement tracks the first summoning."]
	quest.2DC6364FB22850F5.title: "Void Worm"
	quest.2E10BE61E0DE5003.quest_desc: ["Chameleons are tamed with apples and breed on a butterfly in a bottle. Tame ones attack whatever you are fighting."]
	quest.2E10BE61E0DE5003.title: "Chameleon"
	quest.2E747EB948132A40.title: "Scylla"
	quest.2F3A82CEE92B804E.quest_desc: ["Strange technology waits in the Osgood lab. Take a good weapon and do not go alone."]
	quest.2F3A82CEE92B804E.title: "Osgood Lab"
	quest.2F5458C12B01A176.title: "Down the Shaft"
	quest.2FAEE98999C49526.quest_desc: ["A grid of these crafts any recipe, hands free."]
	quest.2FAEE98999C49526.title: "Mechanical Crafter"
	quest.2FDDE3283B2193A8.title: "Emu"
	quest.2FE50E5BC4A777F8.title: "Save the Whale"
	quest.3088C953FB135410.title: "Crocodile Armour"
	quest.313751585FA6BD94.quest_desc: ["Catch the wind. You can dye a sail with any dye."]
	quest.313751585FA6BD94.title: "Sails"
	quest.3179E6E9A5A4F7B2.quest_desc: ["Savanna giants. Feed them acacia blossoms."]
	quest.3179E6E9A5A4F7B2.title: "Elephant"
	quest.32A39FD7588005DF.title: "Ender Golem"
	quest.32CFE52650DB299E.quest_desc: ["Attachments change how a gun feels. Scopes, grips and barrels are made at the Gun Bench."]
	quest.32CFE52650DB299E.title: "Scope"
	quest.330970289E4E0864.quest_desc: ["Place it next to flowing water for free rotation. Your first real power source."]
	quest.330970289E4E0864.title: "Water Wheel"
	quest.33ACA3E0A27F6A0B.quest_desc: ["Funnels put items on a belt or take them off it, and filter with a right-click."]
	quest.33ACA3E0A27F6A0B.title: "Funnels"
	quest.33FB30D83A4B2DEF.quest_desc: [
		"Packagers, Frogports and a Stock Ticker turn a base into a shopping network."
