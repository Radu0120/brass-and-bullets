	quest.742088088BFF29A6.title: "Emu"
	quest.7432A2FDB1E024A5.title: "Throttle"
	quest.74A10E68812B2C4B.quest_desc: ["A boss from the End. Summon it with a mysterious worm; the advancement tracks the first summoning."]
	quest.74A10E68812B2C4B.title: "Void Worm"
	quest.752CE7E2EFF72141.quest_desc: ["Not everything flies. Tires and wheel mounts give you a land vehicle from the same assembler."]
