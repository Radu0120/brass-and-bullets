	quest.735FCBA4C1223B16.title: "Biomass"
	quest.7399AB361EFC96EC.quest_desc: ["Catch the wind. You can dye a sail with any dye."]
	quest.7399AB361EFC96EC.title: "Sails"
	quest.73A86DA727F90BFE.quest_desc: ["Lay track, build a train bogey, and name a station. Trains are slow to set up and very satisfying."]
