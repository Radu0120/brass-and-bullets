	quest.626B7A0FA6E2241D.quest_desc: ["Funnels put items on a belt or take them off it, and filter with a right-click."]
	quest.626B7A0FA6E2241D.title: "Funnels"
	quest.627863A4A1B11F8D.quest_desc: ["Where you stand to steer. Pair it with the Throttle Lever."]
	quest.627863A4A1B11F8D.title: "Steering Wheel"
	quest.63065BD92B2D3266.title: "Freezing Fan"
	quest.6342668FB6B3E4F0.quest_desc: ["Smelt iron ore in a furnace. Create will give you faster ways soon, but the furnace is how everyone starts."]
	quest.6342668FB6B3E4F0.title: "Acquire Hardware"
	quest.6385241173D63725.quest_desc: ["Pulls loose items to you as you mine."]
	quest.6385241173D63725.title: "Magnet"
	quest.638EF2C7552CCF90.title: "Piglin Donjon"
	quest.63AAFBF2EBF5D1DF.quest_desc: ["Boiler + steam engines make serious, steady power. Check the fuel and water tips in the boiler's Jade overlay."]
