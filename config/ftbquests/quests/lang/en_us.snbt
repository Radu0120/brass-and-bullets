	quest.1BA78EBC376B684B.title: "Ignited Revenant"
	quest.1BE833509E94C02E.title: "Storage I/O"
	quest.1C2A87F8CEFE4DD5.quest_desc: ["Create Deco adds catwalks, windows, bars and more. For when the factory should look good too."]
	quest.1C2A87F8CEFE4DD5.title: "Deco"
	quest.1CC17EF11BDEB35F.quest_desc: ["Emperor penguins breed on fish and lay eggs."]
	quest.1CC17EF11BDEB35F.title: "Emperor Penguin"
	quest.1D1259D3FEFDB873.title: "Pulse Generator"
	quest.1D35B180A61B4A04.title: "End Ship"
	quest.1D599253D52B0FED.title: "Flare Pistol"
	quest.1D6A866B437E5DBE.quest_desc: ["The sun chief of the Umvuthana. Treat him with respect."]
	quest.1D6A866B437E5DBE.title: "Barako"
	quest.1DBC34C4CA39C0AE.quest_desc: ["A giant of the snowy lands. The rewards are worth a sore head."]
	quest.1DBC34C4CA39C0AE.title: "Frostmaw"
	quest.1E23A31C42FBC8A0.quest_desc: ["Rises from the sunken city. Do not fight it on a boat."]
