	quest.49CACDDD53106315.quest_desc: ["Crushing wheels double your ore. It is the single biggest upgrade to early game metal."]
	quest.49CACDDD53106315.title: "Millstone \\& Crushing"
	quest.4AB2E80212251F25.title: "Scylla"
	quest.4B7514486E89092E.quest_desc: ["Lets part of a ship rotate freely: gun turrets, cranes, and radar."]
	quest.4B7514486E89092E.title: "Swivel Bearing"
	quest.4B8DA19FD558CCA4.quest_desc: ["Create Crafts \\& Additions adds electricity: motors turn power into rotation and alternators do the opposite."]
	quest.4B8DA19FD558CCA4.title: "Electric Motor"
	quest.4C1DB57B77EB2CEC.quest_desc: ["Eat every dish. It is a long list - JEI helps."]
	quest.4C1DB57B77EB2CEC.title: "Master Chef"
	quest.4C5CED5CFEB229CB.quest_desc: ["A Farmer's Delight recipe the dogs approve of."]
	quest.4C5CED5CFEB229CB.title: "Dog Food"
	quest.4C8111729A072C65.quest_desc: ["Guards the Wrought Chamber. Learn his patterns and dodge."]
	quest.4C8111729A072C65.title: "Ferrous Wroughtnaut"
	quest.4CCC04021921DE99.quest_desc: ["Create Deco adds catwalks, windows, bars and more. For when the factory should look good too."]
	quest.4CCC04021921DE99.title: "Deco"
	quest.4CCDACC20CD4E416.quest_desc: ["Fills items from above: bottles, buckets, chocolate-covered anything."]
	quest.4CCDACC20CD4E416.title: "Spout"
	quest.4CDE8E67E9A60D19.quest_desc: ["Rice grows in shallow water. Cook it into fried rice, rice rolls and many other dishes."]
	quest.4CDE8E67E9A60D19.title: "Rice"
	quest.4CE59A9A5B173D13.quest_desc: ["Copper and zinc, mixed with heat. Brass is the mid-game material: most of this pack's gear wants it."]
	quest.4CE59A9A5B173D13.title: "Brass"
	quest.4D5246EB56272BB0.quest_desc: ["Cuts power before the network breaks. Wire it in before an expensive machine."]
	quest.4D5246EB56272BB0.title: "Overstress Clutch"
	quest.4D635D23DF6EA9C1.title: "Greaser SMG"
	quest.4D6EFDF24EA55D5A.title: "Tusked Elephant"
	quest.4E467554C4C85776.quest_desc: ["Beneath the ocean. The Leviathan rises from it."]
	quest.4E467554C4C85776.title: "Sunken City"
	quest.4E7214563BFC17B3.title: "Shulker Box"
	quest.4EC0BA9CA6921140.quest_desc: ["Create's own storage. Vaults grow big and work with belts, funnels and the Mechanical Arm."]
	quest.4EC0BA9CA6921140.title: "Item Vault"
	quest.50705865B6339F5C.quest_desc: ["Keep your ammo in one place so you can find it in a firefight."]
	quest.50705865B6339F5C.title: "Ammo Box"
	quest.51282A0F8DCF9008.title: "Grottol"
	quest.51ED93630673D574.quest_desc: ["A machine of war from the Ancient Factory."]
	quest.51ED93630673D574.title: "The Harbinger"
	quest.528A39BD4D1A5749.quest_desc: [
		"A slicer cuts food on a belt, a sprinkler waters your fields."
		"Meets Farmer's Delight halfway."
	]
	quest.528A39BD4D1A5749.title: "Slice \\& Dice"
	quest.52C5FB166FAA6CFF.title: "Zombie Dungeon"
	quest.5333EDF377BB5ACD.title: "Down the Shaft"
	quest.53C931ED70AF189E.quest_desc: [
		"Create: Connected adds quality-of-life parts like the Brass Gearbox and Kinetic Battery."
		"Chips are used for the more clever ones."
	]
	quest.53C931ED70AF189E.title: "Control Chip"
	quest.53E63E8429D152DD.title: "Skunk"
	quest.550CF3001E10E548.title: "Rocky Chestplate"
	quest.55273D866C1A734E.quest_desc: [
		"Xaero's Minimap sits in the top right and Xaero's World Map shows everywhere you have been."
		"Set waypoints before you wander off - the nether and the sky both make it very easy to get lost."
	]
	quest.55273D866C1A734E.title: "Find Your Way"
	quest.5567DF1BA3521FEB.quest_desc: ["Moves glued structures along a line. Add extension poles to lengthen its reach."]
	quest.5567DF1BA3521FEB.title: "Mechanical Piston"
	quest.5592CC46F5CAFFD7.title: "Hummingbird Feeder"
	quest.55E419DC7721284F.quest_desc: ["Armadillo scutes make armour for a wolf. Give it to your dog by right-clicking, and repair it with more scutes."]
	quest.55E419DC7721284F.title: "Wolf Armour"
	quest.55FF52C5C11D3194.title: "Mantis Shrimp"
	quest.578FFE8E7E3CE513.title: "Pearlescent Levitite"
	quest.57CF88659A9EE824.quest_desc: ["A propeller on a bearing pushes air - and your ship."]
	quest.57CF88659A9EE824.title: "Propellers"
	quest.57F6A271F5E1465B.quest_desc: ["Ocean monuments are guarded by Guardians. Bring a way to breathe underwater and some milk."]
