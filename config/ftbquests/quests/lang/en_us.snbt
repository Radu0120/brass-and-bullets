	task.488BB110D212C961.title: "Tame a capybara"
	task.4AB0A1273830E401.title: "See what Create can grow into"
	task.4F98037BBD30D6AB.title: "Find a Bestiary creature"
	task.51C0EF6B6FDD96FB.title: "Read me"
	task.57DA0BD6223A1FB8.title: "Tame a crimson or warped newt"
	task.5D978BEEC558BFCD.title: "Tame a parrot"
	task.6020EEFD4B189EC3.title: "Look at the controls"
