	quest.3B5FA140CFDF3137.title: "Mushroom Colony"
	quest.3C508F23063DA208.quest_desc: [
		"&bJEI&r is your recipe book. Items only show up when you type in the search box."
		"Hover an item and press &eR&r for how to make it, or &eU&r for what it is used in."
		"Press &eO&r (or click the bookmark star) to bookmark recipes you want to keep."
	]
	quest.3C508F23063DA208.title: "Recipes \\& Uses"
	quest.3C668A53C87CDC91.title: "Bald Eagle"
	quest.3DA28E880882E26B.quest_desc: ["Where you stand to steer. Pair it with the Throttle Lever."]
	quest.3DA28E880882E26B.title: "Steering Wheel"
	quest.3E5AC1D1375CC972.title: "Lone Citadel"
	quest.3E88B7FBD1FD0A29.quest_desc: [
		"Clutter: Bestiary adds over twenty gentle animals, from capybaras and penguins to butterflies and newts."
		"Most of them spawn in the biome you would expect, so go and look. The Animal Dictionary does not cover them."
	]
	quest.3E88B7FBD1FD0A29.title: "Clutter: Bestiary"
	quest.3EA0799D0A22B286.quest_desc: ["Smithing templates turn an Elytra into one of nineteen coloured Butterfly Elytra. They fly just like the normal ones."]
	quest.3EA0799D0A22B286.title: "Butterfly Wings"
	quest.3F45F70DB71E0534.quest_desc: ["Link chests to the controller to search all of them from one block."]
	quest.3F45F70DB71E0534.title: "Controller"
	quest.3FF7B2AB5084ABE2.title: "Ignitium Armour"
	quest.40030C76F1C38A50.quest_desc: ["Guards the Wrought Chamber. Learn his patterns and dodge."]
	quest.40030C76F1C38A50.title: "Ferrous Wroughtnaut"
	quest.40336FD909828FD3.quest_desc: ["Lay track, build a train bogey, and name a station. Trains are slow to set up and very satisfying."]
	quest.40336FD909828FD3.title: "All Aboard"
	quest.4041D2EE0C63D431.quest_desc: ["Keeps a ship upright. Needed for serious airships."]
	quest.4041D2EE0C63D431.title: "Gyroscopic Mechanism"
	quest.4079F006ED9DF8CC.title: "Flutter"
	quest.40B1DC15981CEDF4.title: "Ancient Stone"
	quest.40DE98DBAE097FB7.title: "Farseer"
	quest.41B44BB1CDC8AE3F.title: "Naga"
	quest.4228F233E9897D07.quest_desc: ["You are not a pilot without goggles."]
	quest.4228F233E9897D07.title: "Aviator"
	quest.4251081415D60C26.quest_desc: ["Fill an envelope with hot air from a burner and the balloon will rise."]
	quest.4251081415D60C26.title: "Hot Air Balloon"
	quest.42769FA3663D26A0.quest_desc: ["Lowers and raises a glued contraption, or a cable of building blocks, on a rope."]
	quest.42769FA3663D26A0.title: "Rope Pulley"
	quest.429DD60AF8EA55D6.title: "Modular Accumulator"
	quest.42BBD7E6E44AE975.title: "Optical Sensor"
	quest.42C35CD12E723741.quest_desc: ["Scorched Guns are made at the Gun Bench. You will need blueprints, so keep an eye on the loot in every structure."]
	quest.42C35CD12E723741.title: "Gun Bench"
	quest.42CCC307FF702CF7.title: "Spider Dungeon"
	quest.43305670A7463815.title: "Dissident"
	quest.43B37890324C4A3B.title: "Worm Slayer"
	quest.443BF0876FD68332.title: "Gyroscopic Bearing"
	quest.44D7FD27030D529F.title: "Tarantula Hawk"
	quest.450C66CCF444D53D.quest_desc: ["River turtles breed on apples and now and then harvest kelp."]
	quest.450C66CCF444D53D.title: "River Turtle"
	quest.46E81D79EEA1024A.title: "Isn't It Iron Pick"
	quest.475C73D2E607BA2C.title: "Frosted Prison"
	quest.47C2D45D9ED3FB55.title: "Toxic Lair"
	quest.4818B24D56A680C5.title: "Gorilla"
	quest.48503F06FDA262CF.quest_desc: ["Assembles blocks into a free-moving \"ship\". Build it, press the button and the whole thing is a physics object."]
	quest.48503F06FDA262CF.title: "Physics Assembler"
	quest.48F3ECC2BDB7E587.quest_desc: ["A proper rifle, and a proper reason to build a bigger workshop."]
	quest.48F3ECC2BDB7E587.title: "Mk43 Rifle"
	quest.48FD97D23D0CB652.title: "Smart Propeller"
	quest.49080A681E4F5D09.quest_desc: ["Wolves come in several variants depending on the biome. Tame one of each."]
	quest.49080A681E4F5D09.title: "The Whole Pack"
	quest.49746C436C4E64AF.quest_desc: ["Use with the track network from the Create chapter: pick a station and the navigator plans your journey."]
	quest.49746C436C4E64AF.title: "Railways Navigator"
	quest.497E8F4C55029EE3.title: "Nether Keep"
	quest.4A3A90864F61E3D5.quest_desc: ["Better Dungeons makes dungeons bigger and better stocked."]
	quest.4A3A90864F61E3D5.title: "Dungeon Delver"
	quest.4A515984B57D1E5C.quest_desc: ["A propeller on a bearing pushes air - and your ship."]
	quest.4A515984B57D1E5C.title: "Propellers"
	quest.4ABE3724E6D54298.quest_desc: ["Armour matters far more here than in vanilla. Wear something before you go looking for dungeons."]
	quest.4ABE3724E6D54298.title: "Suit Up"
	quest.4B8DA19FD558CCA4.quest_desc: ["Create Crafts \\& Additions adds electricity: motors turn power into rotation and alternators do the opposite."]
	quest.4B8DA19FD558CCA4.title: "Electric Motor"
	quest.4C0F8D93A116DB48.title: "End City"
	quest.4C1DB57B77EB2CEC.quest_desc: ["Eat every dish. It is a long list - JEI helps."]
	quest.4C1DB57B77EB2CEC.title: "Master Chef"
	quest.4C5CED5CFEB229CB.quest_desc: ["A Farmer's Delight recipe the dogs approve of."]
	quest.4C5CED5CFEB229CB.title: "Dog Food"
	quest.4C9FC72C875A1E04.quest_desc: [
		"Xaero's Minimap sits in the top right and Xaero's World Map shows everywhere you have been."
		"Set waypoints before you wander off - the nether and the sky both make it very easy to get lost."
	]
	quest.4C9FC72C875A1E04.title: "Find Your Way"
	quest.4CA6549EFAFB16FF.title: "Rattlesnake"
	quest.4CC7AF71DBB0FD62.quest_desc: ["A basin under a mixer makes alloys and doughs. Heat the basin from below with a blaze burner for superheated recipes."]
	quest.4CC7AF71DBB0FD62.title: "Basin \\& Mixer"
	quest.4D5246EB56272BB0.quest_desc: ["Cuts power before the network breaks. Wire it in before an expensive machine."]
	quest.4D5246EB56272BB0.title: "Overstress Clutch"
	quest.4D6EFDF24EA55D5A.title: "Tusked Elephant"
	quest.4E7214563BFC17B3.title: "Shulker Box"
	quest.4F4A9187369C4BE9.quest_desc: [
		"Casings are the shells of most Create machines."
		"Brass casing unlocks the next tier of automation."
	]
	quest.4F4A9187369C4BE9.title: "Casings"
	quest.4F72A8A46043B6D5.title: "Iron Backpack"
	quest.500930BA0745B59A.quest_desc: ["Villages are a good place for beds, bread and trades."]
	quest.500930BA0745B59A.title: "Anyone Home?"
	quest.505792DFC4F00764.quest_desc: ["Visit every kind of Better Dungeons dungeon."]
	quest.505792DFC4F00764.title: "Dungeon Master"
	quest.50705865B6339F5C.quest_desc: ["Keep your ammo in one place so you can find it in a firefight."]
	quest.50705865B6339F5C.title: "Ammo Box"
	quest.50761FB779F90D89.quest_desc: ["A handheld remote for redstone links. Use it to drive contraptions and trains from anywhere."]
	quest.50761FB779F90D89.title: "Linked Controller"
	quest.5117380F9549D352.title: "Getting an Upgrade"
	quest.51282A0F8DCF9008.title: "Grottol"
	quest.5166776A7A273AEE.title: "Leafcutter Ants"
	quest.528A39BD4D1A5749.quest_desc: [
		"A slicer cuts food on a belt, a sprinkler waters your fields."
		"Meets Farmer's Delight halfway."
	]
	quest.528A39BD4D1A5749.title: "Slice \\& Dice"
	quest.52D888EEB14ADB80.title: "Clockwork Bearing"
	quest.53C931ED70AF189E.quest_desc: [
		"Create: Connected adds quality-of-life parts like the Brass Gearbox and Kinetic Battery."
		"Chips are used for the more clever ones."
	]
	quest.53C931ED70AF189E.title: "Control Chip"
	quest.53E63E8429D152DD.title: "Skunk"
	quest.53F546CE9B63D306.quest_desc: ["Sophisticated chests keep their contents when broken. Craft any with just wood."]
	quest.53F546CE9B63D306.title: "A Better Chest"
	quest.5448DC2C5E55BAC6.title: "Diamond Steel"
	quest.544B9E6E2DFB771B.quest_desc: ["Create: Dragons Plus brings End-themed recipes. Collect dragon's breath in a basin."]
	quest.544B9E6E2DFB771B.title: "Dragon's Breath"
	quest.5462C5620B0765B3.title: "Repair Kit"
	quest.5463AE0A689696B4.quest_desc: ["Interact with an empty hand and the panda asks for a particular item. Give it that item three times in a row."]
	quest.5463AE0A689696B4.title: "Red Panda"
	quest.54DE9723D2F92BE9.title: "Acropolis"
	quest.550CF3001E10E548.title: "Rocky Chestplate"
	quest.5567DF1BA3521FEB.quest_desc: ["Moves glued structures along a line. Add extension poles to lengthen its reach."]
	quest.5567DF1BA3521FEB.title: "Mechanical Piston"
	quest.55E419DC7721284F.quest_desc: ["Armadillo scutes make armour for a wolf. Give it to your dog by right-clicking, and repair it with more scutes."]
	quest.55E419DC7721284F.title: "Wolf Armour"
	quest.5741AA4107E1B27A.quest_desc: ["Crushing wheels double your ore. It is the single biggest upgrade to early game metal."]
	quest.5741AA4107E1B27A.title: "Millstone \\& Crushing"
	quest.57F6A271F5E1465B.quest_desc: ["Ocean monuments are guarded by Guardians. Bring a way to breathe underwater and some milk."]
	quest.57F6A271F5E1465B.title: "Deep Dive"
	quest.580EF9788D66891F.title: "Hopper Upgrade"
	quest.58303CE51346B948.title: "Warped Toad"
	quest.58AA5D4868247A13.title: "Mantis Shrimp"
	quest.5928628E297E4658.quest_desc: ["Copies a saved schematic into the world. It eats a lot of materials, so keep it fed with a chest."]
	quest.5928628E297E4658.title: "Schematicannon"
	quest.5961F24AE7129720.quest_desc: ["Boiler + steam engines make serious, steady power. Check the fuel and water tips in the boiler's Jade overlay."]
	quest.5961F24AE7129720.title: "Steam Engine"
	quest.597FEC7B42B47918.title: "Stove"
	quest.59C75941A1FEB9B9.quest_desc: ["Slow to reload, but it fires. Your first gun."]
	quest.59C75941A1FEB9B9.title: "Flintlock"
	quest.5A82ED0089D913ED.title: "Item Drain"
	quest.5AA09355ACA84B3E.quest_desc: ["Find the Cog Chambers."]
	quest.5AA09355ACA84B3E.title: "Cog Chambers"
	quest.5B679972E90D7148.title: "Musket"
	quest.5BA08402445AAC14.title: "Item Silo"
	quest.5BF1C6399730FE3B.title: "Skillet"
	quest.5C8C9C9A4A359CEF.title: "Navigation Table"
	quest.5CB16FB9690C84C0.title: "Kangaroo"
	quest.5D47F4EA8679DD26.title: "Alternator"
	quest.5D68AF7C322A9FE3.quest_desc: ["Tiers up to Netherite add more slots and more upgrade slots."]
	quest.5D68AF7C322A9FE3.title: "Iron Chest"
	quest.5D71623A98A661FB.title: "Barrels"
	quest.5D93696B5DEB4721.quest_desc: ["The backpack survives death or explosion. Worth having."]
	quest.5D93696B5DEB4721.title: "Everlasting"
	quest.5DA07F8D0A1DAA79.quest_desc: ["Beneath the ocean. The Leviathan rises from it."]
	quest.5DA07F8D0A1DAA79.title: "Sunken City"
	quest.5DEE6C438A78E96C.quest_desc: ["Shows information from blocks on signs, boards and nixie tubes. Production counters are very satisfying."]
	quest.5DEE6C438A78E96C.title: "Display Link"
	quest.5DF2307A14A35CBD.quest_desc: ["Ride lava on a board made of straddlite. A Nether classic."]
	quest.5DF2307A14A35CBD.title: "Straddleboard"
	quest.5DF23E0453576640.quest_desc: ["Andesite, plus iron nuggets or zinc. This is the first of Create's key materials."]
	quest.5DF23E0453576640.title: "Andesite Alloy"
	quest.5E59B6F2970B3487.title: "Combat Shotgun"
	quest.5F0C768B81313886.title: "Fluid Tank"
	quest.5F1D908D2DEDCA24.title: "Steam Whistle"
	quest.5F5814C11A10FB3C.title: "Cosmaw"
	quest.5F7B13CC64257016.title: "Jungle Temple"
	quest.5F91D2BEA8B41967.quest_desc: ["Powered armour with room for modules. Look at the Exo Suit Core in JEI."]
	quest.5F91D2BEA8B41967.title: "Exo Suit"
	quest.602012AA9B67228F.title: "Black Steel"
	quest.612A685BBF3DE5F4.quest_desc: ["Place it over a heat source such as a stove or campfire."]
	quest.612A685BBF3DE5F4.title: "Cooking Pot"
	quest.6236DD6950433E11.title: "Monstrous Helm"
	quest.629EC3F1EE7795DC.quest_desc: ["Vitality feed and balanced feed give animals extra health or a longer life. See JEI for the recipes."]
	quest.629EC3F1EE7795DC.title: "Special Feed"
	quest.62D5AAFD94DE79E0.title: "Umvuthana Grove"
	quest.634D29606EC65CCF.quest_desc: ["Throw an ender eye and follow it."]
	quest.634D29606EC65CCF.title: "Stronghold"
	quest.650045BF6B97F733.title: "Frostmaw's Den"
	quest.65AE231DABF41F48.quest_desc: [
		"The &6Explorer's Compass&r points you towards structures such as villages, temples and the many dungeons this pack adds."
		"Check its recipe in JEI, then use it to find your next adventure."
	]
	quest.65AE231DABF41F48.title: "Explorer's Compass"
	quest.65B914E8C3C99A8D.quest_desc: ["The hardest part to make by hand: it needs a sequenced assembly. Look it up in JEI and automate it."]
	quest.65B914E8C3C99A8D.title: "Precision Mechanism"
	quest.65BBEA17596479DD.quest_desc: ["Rice grows in shallow water. Cook it into fried rice, rice rolls and many other dishes."]
	quest.65BBEA17596479DD.title: "Rice"
	quest.65DBC77BA61CFD6E.quest_desc: ["Crimson newts take weeping vines and warped newts take twisting vines. Their backs grow fungi that you can shear off."]
	quest.65DBC77BA61CFD6E.title: "Newts"
	quest.661BB9521118B405.title: "Altitude Sensor"
	quest.667A05BDABF32CBB.title: "Nether Dungeon"
	quest.669F18BF9D29F6A9.title: "Maledictus"
	quest.67AEED21FEB2128F.quest_desc: ["A basket picks up items and hangs from a rope. Great at a market stall."]
	quest.67AEED21FEB2128F.title: "Basket"
	quest.681B20AEA701771C.title: "Enchanter"
	quest.6824188833742E61.title: "Tank Upgrade"
	quest.687C5E159662A66C.title: "Nether Fortress"
	quest.68E395BA4D950EB5.title: "Ender Guardian"
	quest.68F3112C93D990EF.quest_desc: ["Guards your base. Feed it ammo and set its targets."]
	quest.68F3112C93D990EF.title: "Auto Turret"
	quest.69116DA2C6B3D852.title: "Cutting Board"
	quest.69514854A3919F00.title: "Compression"
	quest.6A6DF10808771482.title: "Illager Manor"
	quest.6A708C8FE452C339.quest_desc: ["Every Cataclysm boss, done."]
	quest.6A708C8FE452C339.title: "Slayer of Giants"
	quest.6ABBB7E5FBA5FB89.quest_desc: ["Feed a capybara melon slices to tame it. Tame capybaras sleep at night and heal whoever is nearby."]
	quest.6ABBB7E5FBA5FB89.title: "Capybara"
	quest.6ACA4B0987A81BED.quest_desc: ["Horned mossblooms occasionally shed their antlers, which grow back."]
	quest.6ACA4B0987A81BED.title: "Mossbloom Antlers"
	quest.6ADA42CC34DC6DE6.quest_desc: ["Paint chests and barrels any colour, and change their wood and trim."]
	quest.6ADA42CC34DC6DE6.title: "Paint Job"
	quest.6B73647846873425.title: "First Rounds"
	quest.6BA82933E1359447.quest_desc: [
		"Put an item on a belt or depot under the press to make sheets."
		"Pressed iron, copper and gold sheets feed almost everything that follows."
	]
	quest.6BA82933E1359447.title: "Mechanical Press"
	quest.6BB14B21200B4A7E.quest_desc: [
		"&bImprovable Skills&r lets you spend experience on permanent upgrades such as mining speed, health or fall protection."
		"Look up the Skills Book in JEI. Quest rewards pay in XP, so every quest here nudges you towards your next skill."
	]
	quest.6BB14B21200B4A7E.title: "Book of Skills"
	quest.6D726E5DA0967109.quest_desc: ["Docks a moving contraption to a station and trades its items. Think mine carts with a cargo bay."]
	quest.6D726E5DA0967109.title: "Portable Storage"
	quest.6D97678C4739C605.quest_desc: ["Redcoats patrol the world. Take a few down - carefully."]
	quest.6D97678C4739C605.title: "Hold the Line"
	quest.6DCA7FC464897EA5.quest_desc: ["Catch a blaze from a spawner in a Nether fortress with an empty burner, then feed it. A burner under a basin heats it."]
	quest.6DCA7FC464897EA5.title: "Blaze Burner"
	quest.6ECFD81921856DE2.title: "Transmutation Table"
	quest.6EF8AADCDB5DB761.quest_desc: ["Moves items between any two inventories. Link it to inputs and outputs with the Wrench."]
	quest.6EF8AADCDB5DB761.title: "Mechanical Arm"
	quest.6FB6BE55107A4B96.quest_desc: [
		"Offer a wolf bones until hearts appear. Tame wolves follow you, fight for you, and sit when you tell them to."
		"Cats are tamed with raw cod or salmon."
	]
	quest.6FB6BE55107A4B96.title: "A Dog's Best Friend"
	quest.6FB8A227FE08908E.title: "Fried Rice"
	quest.6FD7238A4E58CCAC.title: "Compost"
	quest.713A480CECFFBD2E.quest_desc: ["Very far from home, and very full of evokers."]
	quest.713A480CECFFBD2E.title: "Woodland Mansion"
	quest.7209BCAE567F88AB.title: "Sprinkler"
	quest.72A47AE97F0F7B8E.title: "Wizard's Tower"
	quest.7432A2FDB1E024A5.title: "Throttle"
	quest.7484C0DD7FF33F47.title: "Honey-Glazed Ham"
	quest.74D289E5A20843AC.quest_desc: ["Feed kiwis seeds to make them lay eggs. They dance when a jukebox plays."]
	quest.74D289E5A20843AC.title: "Kiwi"
	quest.752CE7E2EFF72141.quest_desc: ["Not everything flies. Tires and wheel mounts give you a land vehicle from the same assembler."]
	quest.752CE7E2EFF72141.title: "On the Ground"
	quest.7552B96E831EF6DD.quest_desc: ["When a butterfly hatches from a cocoon there is a chance it drops a template shard."]
	quest.7552B96E831EF6DD.title: "Cocoon Shards"
	quest.7584D814CBA3061C.title: "Maned Wolf"
	quest.76021D88DED7A244.title: "Trenches"
	quest.760EEDC2AB5EA87A.quest_desc: ["Create's own storage. Vaults grow big and work with belts, funnels and the Mechanical Arm."]
	quest.760EEDC2AB5EA87A.title: "Item Vault"
	quest.768E45FF9F3042E4.quest_desc: ["Critter Armory adds armour for cats, pigs, cows, sheep and chickens, in iron, gold, diamond and netherite."]
	quest.768E45FF9F3042E4.title: "Armour for Everyone"
	quest.76C90508CF4BDBD0.title: "End Castle"
	quest.76E4D391B428F74A.title: "Wrought Chamber"
	quest.775CEAA4D023A2CD.quest_desc: ["A fake player on a stick: it uses, places and applies items. Feed it a belt and you have a sequenced assembly line."]
	quest.775CEAA4D023A2CD.title: "Deployer"
	quest.782AA180F2EDF471.quest_desc: ["Copper and tuff chambers deep underground, full of vaults and spawners that keep coming."]
	quest.782AA180F2EDF471.title: "Trial Chambers"
	quest.7995B039FA9E7B93.quest_desc: ["Lets part of a ship rotate freely: gun turrets, cranes, and radar."]
	quest.7995B039FA9E7B93.title: "Swivel Bearing"
	quest.799E1076FF1C47A9.title: "Diamond Pets"
	quest.79FDB6A8B5A65E00.quest_desc: ["Link two connectors to carry electricity over a distance."]
	quest.79FDB6A8B5A65E00.title: "Connect it Up"
	quest.7ABD1C64AE6025CA.quest_desc: ["Butterflies come in sixteen Overworld colours and three Nether ones, breed on sugar and can be carried in a bottle."]
	quest.7ABD1C64AE6025CA.title: "Butterflies"
	quest.7AD2BD073A59DB0D.quest_desc: ["Seal a chest with tape and carry it, items and all."]
	quest.7AD2BD073A59DB0D.title: "Packing Tape"
	quest.7AE7F2DA6149F569.title: "Tesla Coil"
	quest.7B08AACDFBBA4CA8.title: "Diamond Backpack"
	quest.7B541FF688E442E6.quest_desc: ["The endgame rifle. Expensive in every way."]
	quest.7B541FF688E442E6.title: "Gauss Rifle"
	quest.7B7767480B971577.quest_desc: ["Request production on demand: put a gauge on a chest and it will order what is missing."]
	quest.7B7767480B971577.title: "Factory Gauge"
	quest.7C5E21A17A030622.quest_desc: ["Do not make noise. Do not bring a torch. Bring a lot of food."]
	quest.7C5E21A17A030622.title: "Ancient City"
	quest.7C72DC023FB9AFA3.quest_desc: ["Spins glued structures. Windmills, drills on arms, and so on."]
	quest.7C72DC023FB9AFA3.title: "Mechanical Bearing"
	quest.7D2A43CE7327217C.quest_desc: ["Pump up lava, water or oil from large pools. Infinite water, and endless lava for the boiler."]
	quest.7D2A43CE7327217C.title: "Hose Pulley"
	quest.7D634E2B24BC98A2.quest_desc: ["Jellyfish sting anything that is not aquatic that comes near. Manta rays hunt them."]
	quest.7D634E2B24BC98A2.title: "Jellyfish"
	quest.7EC198492A10A46F.title: "Over an Open Flame"
	quest.7EEFCB7C2EC7EB8C.title: "Ancient Remnant"
	quest.7F054EBF0C0EE1B7.title: "Docking"
