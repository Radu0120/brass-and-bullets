	quest.179F2A8D0A74E5AA.title: "Rolling Mill"
	quest.18ABBC3417EA5EB3.title: "Tiger's Blessing"
	quest.18B0240AC87846D5.title: "Orca's Might"
	quest.18B4024F630C9D2F.quest_desc: ["Ferment biomass into a liquid fuel. It runs liquid blaze burners and engines."]
