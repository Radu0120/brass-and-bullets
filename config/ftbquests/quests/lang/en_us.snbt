{
	chapter.00AFB464B9627264.chapter_subtitle: [
		"Tame, breed and look after every animal"
		"Farm animals, pets, and the odd frog"
	]
	chapter.00AFB464B9627264.title: "&dPets \\& Livestock"
	chapter.14921B4A6D14BD31.chapter_subtitle: [
