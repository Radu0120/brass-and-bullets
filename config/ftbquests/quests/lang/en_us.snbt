	quest.580EF9788D66891F.title: "Hopper Upgrade"
	quest.58303CE51346B948.title: "Warped Toad"
	quest.597FEC7B42B47918.title: "Stove"
	quest.59C75941A1FEB9B9.quest_desc: ["Slow to reload, but it fires. Your first gun."]
	quest.59C75941A1FEB9B9.title: "Flintlock"
	quest.5A2CED51C5271D3C.quest_desc: ["Hidden in the overworld. The Harbinger sleeps inside."]
	quest.5A2CED51C5271D3C.title: "Ancient Factory"
	quest.5A592603C6D1AA78.quest_desc: ["Open &eOptions > Controls&r and use the search box. This pack adds a handful of keys for the minimap, skills book, backpacks and more."]
	quest.5A592603C6D1AA78.title: "Check Your Controls"
