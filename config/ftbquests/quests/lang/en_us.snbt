{
	chapter.02D449A97E887C69.chapter_subtitle: ["Powder, brass and a lot of gunsmithing"]
	chapter.02D449A97E887C69.title: "&cScorched Guns"
	chapter.08C690E81AEBBDA6.chapter_subtitle: [
